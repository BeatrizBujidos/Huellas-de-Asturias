{
  "info": {
    "name": "Proyecto - Huellas de Asturias",
    "description": "Colección completa de endpoints para probar la API del proyecto final. Base URL: http://localhost:8080/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Artistas",
      "item": [
        {
          "name": "POST - Crear Artista",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/artistas", "host": ["{{baseUrl}}"], "path": ["artistas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Francisco\",\n  \"apellidos\": \"Goya y Lucientes\",\n  \"fechaNacimiento\": \"1746-03-30\",\n  \"fechaMuerte\": \"1828-04-16\",\n  \"lugarNacimiento\": \"Fuendetodos, Zaragoza\",\n  \"biografia\": \"Francisco José de Goya y Lucientes fue un pintor y grabador español considerado el padre del arte moderno. Su obra abarca desde los cartones para tapices hasta los dramáticos grabados de Los desastres de la guerra.\",\n  \"biografiaEn\": \"Francisco José de Goya y Lucientes was a Spanish painter and printmaker considered the father of modern art. His work ranges from tapestry cartoons to dramatic war etchings.\",\n  \"estilo\": \"Romanticismo\",\n  \"imagen\": \"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Goya_Autoportrait_1783.jpg/400px-Goya_Autoportrait_1783.jpg\"\n}"
            }
          }
        },
        {
          "name": "GET - Obtener Artista por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/artistas/1", "host": ["{{baseUrl}}"], "path": ["artistas", "1"] }
          }
        },
        {
          "name": "GET - Listar Todos los Artistas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/artistas", "host": ["{{baseUrl}}"], "path": ["artistas"] }
          }
        },
        {
          "name": "GET - Buscar por Nombre y Apellidos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artistas/nombreYapellidos?nombre=Francisco&apellidos=Goya y Lucientes",
              "host": ["{{baseUrl}}"],
              "path": ["artistas", "nombreYapellidos"],
              "query": [
                { "key": "nombre", "value": "Francisco" },
                { "key": "apellidos", "value": "Goya y Lucientes" }
              ]
            }
          }
        },
        {
          "name": "GET - Buscar por Estilo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artistas/estilo?estilo=Romanticismo",
              "host": ["{{baseUrl}}"],
              "path": ["artistas", "estilo"],
              "query": [{ "key": "estilo", "value": "Romanticismo" }]
            }
          }
        },
        {
          "name": "PUT - Actualizar Artista",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/artistas/1", "host": ["{{baseUrl}}"], "path": ["artistas", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"biografia\": \"Francisco José de Goya y Lucientes (1746-1828) fue un pintor y grabador español, considerado tanto el último gran maestro de la pintura española del siglo XVIII como el primero de los grandes maestros del siglo XIX. Retratista de la familia real española y crítico de la sociedad de su época.\",\n  \"estilo\": \"Neoclasicismo, Romanticismo\"\n}"
            }
          }
        },
        {
          "name": "DELETE - Eliminar Artista",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/artistas/1", "host": ["{{baseUrl}}"], "path": ["artistas", "1"] }
          }
        }
      ]
    },
    {
      "name": "Épocas",
      "item": [
        {
          "name": "POST - Crear Época",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/epocas", "host": ["{{baseUrl}}"], "path": ["epocas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Renacimiento\",\n  \"descripcion\": \"Movimiento cultural y artístico europeo surgido en Italia en el siglo XIV que se extendió hasta el siglo XVII, caracterizado por el redescubrimiento del arte y la cultura clásica grecolatina.\",\n  \"fechaInicio\": \"1400\",\n  \"fechaFin\": \"1600\",\n  \"caracteristicas\": \"Perspectiva lineal, humanismo, uso de la luz y sombra (claroscuro), equilibrio y armonía en la composición, temática religiosa y mitológica\"\n}"
            }
          }
        },
        {
          "name": "GET - Obtener Época por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/epocas/1", "host": ["{{baseUrl}}"], "path": ["epocas", "1"] }
          }
        },
        {
          "name": "GET - Buscar Época por Nombre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/epocas/nombre?nombre=Renacimiento",
              "host": ["{{baseUrl}}"],
              "path": ["epocas", "nombre"],
              "query": [{ "key": "nombre", "value": "Renacimiento" }]
            }
          }
        },
        {
          "name": "GET - Listar Todas las Épocas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/epocas/listado", "host": ["{{baseUrl}}"], "path": ["epocas", "listado"] }
          }
        },
        {
          "name": "PUT - Actualizar Época",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/epocas/1", "host": ["{{baseUrl}}"], "path": ["epocas", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"El Renacimiento fue un florecimiento cultural e intelectual que comenzó en Italia y se extendió por toda Europa. Supuso el redescubrimiento del legado clásico grecolatino y el nacimiento del humanismo.\",\n  \"caracteristicas\": \"Perspectiva lineal, humanismo, claroscuro, equilibrio, armonía compositiva, temática religiosa, mitológica y retratos\"\n}"
            }
          }
        },
        {
          "name": "DELETE - Eliminar Época",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/epocas/1", "host": ["{{baseUrl}}"], "path": ["epocas", "1"] }
          }
        }
      ]
    },
    {
